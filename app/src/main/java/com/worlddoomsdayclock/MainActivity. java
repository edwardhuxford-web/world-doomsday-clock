package com.worlddoomsdayclock;

import android.app.Activity;
import android.os.Bundle;
import android.graphics.Color;
import android.graphics.Typeface;
import android.view.Gravity;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

public class MainActivity extends Activity {

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        ScrollView scroll = new ScrollView(this);

        LinearLayout layout = new LinearLayout(this);
        layout.setOrientation(LinearLayout.VERTICAL);
        layout.setGravity(Gravity.CENTER_HORIZONTAL);
        layout.setPadding(40, 60, 40, 60);
        layout.setBackgroundColor(Color.BLACK);

        TextView title = makeText(
                "WORLD DOOMSDAY CLOCK",
                28, Color.WHITE, true);
        layout.addView(title);

        TextView subtitle = makeText(
                "GLOBAL RISK MONITOR",
                15, Color.LTGRAY, false);
        layout.addView(subtitle);

        TextView clock = makeText(
                "90 SECONDS",
                52, Color.RED, true);
        clock.setPadding(0, 45, 0, 0);
        layout.addView(clock);

        TextView midnight = makeText(
                "TO MIDNIGHT",
                22, Color.WHITE, true);
        layout.addView(midnight);

        TextView status = makeText(
                "CURRENT GLOBAL RISK LEVEL",
                16, Color.LTGRAY, false);
        status.setPadding(0, 55, 0, 10);
        layout.addView(status);

        TextView risk = makeText(
                "CRITICAL",
                30, Color.RED, true);
        layout.addView(risk);

        TextView description = makeText(
                "\nThe World Doomsday Clock monitors major global risks including nuclear conflict, climate change, artificial intelligence, pandemics and geopolitical instability.",
                17, Color.WHITE, false);
        layout.addView(description);

        TextView footer = makeText(
                "\nWORLD DOOMSDAY CLOCK\nGlobal Risk Monitoring System",
                14, Color.LTGRAY, false);
        layout.addView(footer);

        scroll.addView(layout);
        setContentView(scroll);
    }

    private TextView makeText(String text, int size, int color, boolean bold) {
        TextView view = new TextView(this);
        view.setText(text);
        view.setTextSize(size);
        view.setTextColor(color);
        view.setGravity(Gravity.CENTER);
        view.setPadding(10, 12, 10, 12);

        if (bold) {
            view.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        }

        return view;
    }
}
